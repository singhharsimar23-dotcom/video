# Copy this file to .env.local and fill in your values.
# Required for the dashboard to connect to your forked repo.

# Your GitHub repo in owner/repo format (e.g. yourusername/video)
NEXT_PUBLIC_GITHUB_REPO=owner/repo

# Branch that data/library.json lives on (default: main)
NEXT_PUBLIC_GITHUB_BRANCH=main

# Set automatically by the deploy_dashboard workflow from GITHUB_REPOSITORY.
# Only needed for local development if basePath differs.
# NEXT_PUBLIC_BASE_PATH=
